# Public deployment
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Highest-priority database table environment: dev or prod
DATABASE_ENVIRONMENT=dev

# Supabase (current publishable and secret API keys; do not use legacy JWT keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Administrator access; comma-separated and enforced before magic-link delivery
ADMIN_EMAILS=

# Transactional email; when omitted in development, authorized admins sign in without an email round trip
RESEND_API_KEY=
RESEND_FROM_EMAIL="Rein Community <community@mail.example.org>"
RESEND_WELCOME_TEMPLATE_ID=rein-community-welcome

# OpenAI Responses API
OPENAI_API_KEY=
